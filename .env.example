# Frontend público
NEXT_PUBLIC_SITE_URL=https://www.solucionescatastrales.app
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Formularios de contacto (solo servidor)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
EMAIL_USER=cuenta@example.com
EMAIL_PASS=clave-de-aplicacion
CONTACT_EMAIL=destino@example.com

# Identificación que debe publicarse en el aviso legal
LEGAL_TAX_ID=00000000X
LEGAL_PROFESSIONAL_BODY=Nombre del colegio profesional
LEGAL_REGISTRATION_NUMBER=0000

# Backend FastAPI
APP_ENV=development
LOG_LEVEL=INFO
ADMITTED_ORIGINS=https://www.solucionescatastrales.app
MAX_UPLOAD_BYTES=26214400
MAX_JSON_REQUEST_BYTES=16777216
MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
MAX_ARCHIVE_MEMBERS=200
MAX_CONCURRENT_GIS_JOBS=2
GIS_QUEUE_TIMEOUT_MS=2000
